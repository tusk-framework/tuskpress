{
    "name": "tuskpress/tuskpress",
    "description": "WordPress reescrito com Tusk Framework — motor moderno, interface familiar",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "keywords": ["wordpress", "tusk", "cms", "blog", "php8"],
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.4",
        "doctrine/instantiator": "~2.0.0",
        "doctrine/orm": "^3.6",
        "firebase/php-jwt": "^7.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "tusk-framework/framework": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "TuskPress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TuskPress\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "analyse": "phpstan analyse src --level=8",
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "prefer-stable": true
}
